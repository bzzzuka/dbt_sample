# Normalize text files; keep Windows scripts native for PowerShell 5.1.
* text=auto

# Shell / Linux / Python / dbt / compose must be LF.
*.sh       text eol=lf
*.bash     text eol=lf
*.py       text eol=lf
*.sql      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.conf     text eol=lf
*.properties text eol=lf
*.md       text eol=lf
*.env      text eol=lf
.env        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Windows-only scripts stay CRLF.
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
