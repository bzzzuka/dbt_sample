[0m21:10:39.140164 [debug] [Thread-1 (]: On model.my_dbt_project.mart_delivery_kpi: /* {"app": "dbt", "dbt_version": "1.7.0", "profile_name": "default", "target_name": "dev", "node_id": "model.my_dbt_project.mart_delivery_kpi"} */

  
    

  create  table "dbt_db"."public"."mart_delivery_kpi__dbt_tmp"
  
  
    as
  
  (
    

WITH shipments AS (
    SELECT
        s.shipment_id,
        s.supply_order_id,
        s.ship_date,
        s.delivery_date,
        s.transport_mode,
        s.container_type,
        s.weight_kg,
        s.shipping_cost,
        s.status,
        -- срок доставки в днях
        (s.delivery_date - s.ship_date) AS delivery_days,
        o.priority
    FROM "dbt_db"."public"."stg_shipments" s
    LEFT JOIN "dbt_db"."public"."stg_supply_orders" o USING (supply_order_id)
)
SELECT
    transport_mode,
    container_type,
    priority,
    COUNT(*)                                        AS shipments_count,
    SUM(weight_kg)                                  AS total_weight_kg,
    SUM(shipping_cost)                              AS total_shipping_cost,
    AVG(shipping_cost)                              AS avg_shipping_cost,
    AVG(delivery_days)                              AS avg_delivery_days,
    MIN(delivery_days)                              AS min_delivery_days,
    MAX(delivery_days)                              AS max_delivery_days,
    COUNT(*) FILTER (WHERE status = 'delivered')    AS delivered_count,
    COUNT(*) FILTER (WHERE status = 'cancelled')    AS cancelled_count,
    COUNT(*) FILTER (WHERE status = 'returned')     AS returned_count
FROM shipments
GROUP BY transport_mode, container_type, priority
  );
  
